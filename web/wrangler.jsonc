{
  "name": "archers",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ArchersRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArchersRoom"] }],
  "routes": [{ "pattern": "archers.weston.pub", "custom_domain": true }]
}
